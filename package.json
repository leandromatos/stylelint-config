{
  "name": "@leandromatos/stylelint-config",
  "version": "4.0.2",
  "description": "Stylelint configuration for SCSS, CSS-in-JS, and Tailwind CSS.",
  "keywords": [
    "stylelint",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/stylelint-config.git"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "lint": "yarn lint:js",
    "lint:js": "eslint .",
    "lint:fix": "yarn lint:fix:js",
    "lint:fix:js": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "release:snapshot": "./scripts/snapshot-version-bump.sh",
    "release:production": "./scripts/production-version-bump.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "postcss": "^8.5.23",
    "postcss-scss": "^4.0.9",
    "postcss-styled-syntax": "^0.7.2",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-tailwindcss": "^1.0.1"
  },
  "peerDependencies": {
    "stylelint": ">=16"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@leandromatos/commitlint-config": "^1.0.1",
    "@leandromatos/eslint-config": "^3.0.1",
    "@leandromatos/prettier-config": "^2.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
